WORKBENCH_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/ai_workbench
WORKBENCH_WORKSPACE_ID=default
WORKBENCH_LOG_LEVEL=INFO
# Generate once with: openssl rand -base64 32
WORKBENCH_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
WORKBENCH_WORKER_POLL_INTERVAL_SECONDS=1
WORKBENCH_WORKER_LEASE_SECONDS=30
WORKBENCH_WORKER_HEARTBEAT_SECONDS=10
WORKBENCH_WORKER_MAX_ATTEMPTS=3
WORKBENCH_TEST_DATABASE_URL=postgresql+psycopg://postgres:change-me@localhost:5432/ai_workbench_test
