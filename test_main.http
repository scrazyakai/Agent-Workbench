@baseUrl = http://127.0.0.1:8000

### Health
GET {{baseUrl}}/health
Accept: application/json

### Create a model connection
# Replace the key and model with values supported by your Chat Completions provider.
POST {{baseUrl}}/v1/model-connections
Content-Type: application/json

{
  "name": "OpenAI Demo",
  "provider": "openai_compatible",
  "model_name": "your-chat-model",
  "base_url": "https://api.openai.com/v1",
  "api_key": "replace-with-a-real-api-key",
  "timeout_seconds": 10,
  "enabled": true
}

> {% client.global.set("connectionId", response.body.id); %}

### Test the model connection
POST {{baseUrl}}/v1/model-connections/{{connectionId}}/test

### Register an HTTP Tool
POST {{baseUrl}}/v1/tools
Content-Type: application/json

{
  "name": "HTTP Echo Demo",
  "description": "Demonstrate fixed-target HTTP tool execution",
  "owner": "platform",
  "tool_type": "http",
  "input_schema": {
    "type": "object",
    "properties": {"topic": {"type": "string"}},
    "required": ["topic"],
    "additionalProperties": false
  },
  "config": {
    "method": "GET",
    "endpoint": "https://httpbin.org/anything/{topic}",
    "allowed_hosts": ["httpbin.org"],
    "path_params": {"topic": "topic"},
    "body_mode": "none"
  },
  "risk_level": "read"
}

> {% client.global.set("toolId", response.body.id); %}

### Test the HTTP Tool draft
POST {{baseUrl}}/v1/tools/{{toolId}}/test
Content-Type: application/json

{"arguments": {"topic": "workbench"}}

### Publish immutable ToolVersion v1
POST {{baseUrl}}/v1/tools/{{toolId}}/versions

### MCP tools use tool_type=mcp, a Streamable HTTP server_url and remote_tool_name.
### POST {{baseUrl}}/v1/tools/{{toolId}}/discover lists tools exposed by that MCP Server.

### Create a draft (use a new name when repeating)
POST {{baseUrl}}/v1/agents
Content-Type: application/json

{
  "name": "运营数据助手",
  "system_prompt": "分析提供的运营数据并返回结论。",
  "model_config": {"connection_id": "{{connectionId}}"},
  "input_schema": {"type": "object"},
  "tags": ["demo"],
  "tool_bindings": [{"tool_id": "{{toolId}}", "version": 1}]
}

> {% client.global.set("agentId", response.body.id); %}

### List drafts
GET {{baseUrl}}/v1/agents?offset=0&limit=20

### Filter by tag
GET {{baseUrl}}/v1/agents?tag=demo&limit=20

### Draft detail
GET {{baseUrl}}/v1/agents/{{agentId}}

### Publish immutable snapshot
POST {{baseUrl}}/v1/agents/{{agentId}}/versions

> {% client.global.set("agentVersion", response.body.version); %}

### Create a durable deterministic Run
POST {{baseUrl}}/v1/runs
Content-Type: application/json

{
  "execution_mode": "deterministic",
  "target": {"type": "agent", "id": "{{agentId}}", "version": {{agentVersion}}},
  "thread_id": "demo-thread",
  "input": {"question": "分析本周销售趋势"},
  "idempotency_key": "demo-run-1"
}

> {% client.global.set("runId", response.body.id); %}

### Run detail (start `uv run python -m app.worker` to execute it)
GET {{baseUrl}}/v1/runs/{{runId}}

### Poll durable events after cursor 0
GET {{baseUrl}}/v1/runs/{{runId}}/events?after=0&limit=100

### Stream durable events (server closes after terminal status; reconnect uses Last-Event-ID)
GET {{baseUrl}}/v1/runs/{{runId}}/stream?after=0
Accept: text/event-stream

### Inspect step-level Trace
GET {{baseUrl}}/v1/runs/{{runId}}/steps

### Create a real model Run — may incur provider charges
POST {{baseUrl}}/v1/runs
Content-Type: application/json

{
  "execution_mode": "model",
  "target": {"type": "agent", "id": "{{agentId}}", "version": {{agentVersion}}},
  "input": {"question": "分析以下销售额变化", "sales": [100, 120, 150]},
  "idempotency_key": "demo-model-run-1"
}

> {% client.global.set("runId", response.body.id); %}

### Cancel queued/running Run (idempotent)
POST {{baseUrl}}/v1/runs/{{runId}}/cancel

### Edit only draft
PATCH {{baseUrl}}/v1/agents/{{agentId}}
Content-Type: application/json

{"system_prompt": "分析数据并列出关键指标与限制。"}

### List versions
GET {{baseUrl}}/v1/agents/{{agentId}}/versions

### Version 1 retains original prompt
GET {{baseUrl}}/v1/agents/{{agentId}}/versions/1
